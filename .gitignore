# 의존성
node_modules/

# 빌드 결과물
dist/
build/

# 환경 변수 / 로컬 설정
# .env.* 로 넓게 막는다 — .env.production 같은 걸 새로 만들어 실수로 커밋하는 사고 방지.
# (예시 파일은 일부러 통과시킨다)
.env
.env.*
!.env.example
*.local

# 비밀키 · 인증서 (공개 저장소라 한 번 올라가면 히스토리에서 못 지운다)
*.pem
*.p12
*.pfx
*.key

# 터널 설정 (ngrok authtoken 이 이 안에 들어간다)
ngrok.yml
.ngrok/

# 로그
*.log
npm-debug.log*

# 에디터 / OS
.DS_Store
.DS_Store?
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code 로컬 설정 (프로젝트 규칙 CLAUDE.md 는 루트에 있어 그대로 추적됨)
.claude/

# Vite가 자동 생성하는 HTTPS 인증서 캐시
client/.vite/
**/.cert/

# 마스코트 디자인
mascot-preview.jsx
